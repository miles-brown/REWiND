# ==============================================================================
# REWIND Evidence Atlas — Environment Configuration Template
# Copy this file to .env.local and populate with your environment credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & CANONICAL METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="REWIND Evidence Atlas"
NEXT_PUBLIC_ATLAS_EDITION="2026.1-diplomatic-network"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. DATABASE & STORAGE (Cloudflare D1 / Drizzle ORM)
# ------------------------------------------------------------------------------
# Local development simulates D1 in-memory; populate these for remote deployments:
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_D1_DATABASE_ID=""
CLOUDFLARE_API_TOKEN=""
DATABASE_URL=""

# ------------------------------------------------------------------------------
# 3. AI & FORENSIC TRANSCRIPTION APIs (Optional / Background Research)
# ------------------------------------------------------------------------------
# Gemini API Key for speech transcription and document corroboration:
GEMINI_API_KEY=""
# OpenAI API Key (optional):
OPENAI_API_KEY=""

# ------------------------------------------------------------------------------
# 4. GEOSPATIAL & VECTOR TILES (Optional)
# ------------------------------------------------------------------------------
# Default uses embedded SVG vector coastlines. Provide key if using external tiles:
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ------------------------------------------------------------------------------
# 5. SECURITY & WORKSPACE AUTH
# ------------------------------------------------------------------------------
SESSION_SECRET=""
