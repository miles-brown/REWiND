# ==============================================================================
# REWIND Evidence Atlas — Environment Configuration Template
# Copy this file to .env.local and populate with your environment credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & CANONICAL METADATA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="REWIND Evidence Atlas"
NEXT_PUBLIC_ATLAS_EDITION="2026.1-diplomatic-network"
NODE_ENV="development"

# ------------------------------------------------------------------------------
# 2. SUPABASE & POSTGRESQL DATABASE (Drizzle ORM)
# ------------------------------------------------------------------------------
# Direct Postgres Connection URI (from Supabase Project Settings -> Database -> Connection string -> URI / Transaction Pooler)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres"

# Supabase Client Credentials (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 3. AI & FORENSIC TRANSCRIPTION APIs (Optional / Background Research)
# ------------------------------------------------------------------------------
# Gemini API Key for speech transcription and primary document corroboration:
GEMINI_API_KEY=""
# OpenAI API Key (optional):
OPENAI_API_KEY=""

# ------------------------------------------------------------------------------
# 4. GEOSPATIAL & VECTOR TILES (Optional)
# ------------------------------------------------------------------------------
# Default uses embedded MapLibre GL dark vector basemap with raster fallbacks:
NEXT_PUBLIC_MAPBOX_TOKEN=""

# ------------------------------------------------------------------------------
# 5. SECURITY & WORKSPACE AUTH
# ------------------------------------------------------------------------------
SESSION_SECRET=""
